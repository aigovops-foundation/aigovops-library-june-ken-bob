# deploy/enclave/templates/enclave.1password.env.tmpl — the MANAGED ("Jeeves")
# enclave posture: 1Password is the broker. Rendered by render-env.sh with
# ENCLAVE_SECRETS=1password.
#
# WHY THIS EXISTS: the air-gapped template (enclave.env.tmpl) needs a HashiCorp
# Vault you `vault operator init` + unseal by hand — the single worst human step.
# Here the broker resolves scoped, short-lived credentials from a 1Password vault
# instead, so the ONLY secret you paste on the host is one service-account token.
#
# TRADEOFF, STATED PLAINLY: 1Password is a cloud store, so this posture is NOT
# air-gapped — the enclave must be able to reach 1Password. For a regulated,
# offline-verify deployment use enclave.env.tmpl (Vault). enclave.js knows both:
# `enclaveSecretsKind()` reports which is in force and flags this cloud tradeoff.
#
# NO SECRETS IN THIS TEMPLATE OR THE RENDERED FILE. The op:// lines are
# references, not values — the core resolves them at boot via the service
# account. .gitignore covers deploy/enclave/*.env.

# --- T2 secrets: brokered by 1Password (no Vault to init/unseal) ---------------
SECRETS_PROFILE=1password
OP_VAULT=${OP_VAULT}
OP_FIELD=${OP_FIELD}
# OP_SERVICE_ACCOUNT_TOKEN=   <- THE ONE HUMAN PASTE. Create it in the 1Password
#                                console (Developer -> Service Accounts), grant
#                                read on the '${OP_VAULT}' vault, paste here.
#                                Never committed; treat it like a root password.

# --- T4 sandbox: kernel-level isolation ---------------------------------------
SANDBOX_BACKEND=gvisor
SANDBOX_IMAGE=${SANDBOX_IMAGE}
SANDBOX_EGRESS_NET=${SANDBOX_EGRESS_NET}
# Egress DENY-ALL. Leave empty: tools get only the hosts they declare per run.
SANDBOX_DEFAULT_EGRESS=

# --- models: internal only, nothing leaves the perimeter ----------------------
ALLOW_CLOUD=false

# --- T7 policy: Yes-Gate rules as signed rego ---------------------------------
POLICY_ENGINE=opa
POLICY_DIR=${POLICY_DIR}

# --- T8 identity: in-perimeter OIDC; client secret brokered from 1Password -----
OIDC_ISSUER=${OIDC_ISSUER}
OIDC_CLIENT_ID=${OIDC_CLIENT_ID}
OIDC_REDIRECT_URI=${OIDC_REDIRECT_URI}
OIDC_STEWARD_GROUP=${OIDC_STEWARD_GROUP}
OIDC_CLIENT_SECRET=op://${OP_VAULT}/oidc/client-secret

# --- storage + core secrets: all brokered from 1Password ----------------------
DATABASE_URL=op://${OP_VAULT}/postgres/url
SESSION_SECRET=op://${OP_VAULT}/session/secret
STEWARD_TOKEN=op://${OP_VAULT}/ops/steward-token

# --- the core -----------------------------------------------------------------
PORT=${PORT}
LEDGER_DIR=${LEDGER_DIR}
KEYS_DIR=${KEYS_DIR}
