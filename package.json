{
  "name": "aigovops-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AiGovOps Library \u2014 the whole set (demo, design book, blueprint, plan, core).",
  "license": "Apache-2.0",
  "scripts": {
    "build:docs": "node scripts/build-docs.mjs",
    "audit:repos": "node scripts/repo-audit.mjs --open",
    "estate:exec": "node scripts/estate-exec-digest.mjs",
    "estate:check": "node scripts/estate-manifest.mjs --check",
    "estate:regen": "node scripts/estate-manifest.mjs --regen",
    "autonomy:check": "node scripts/autonomy-check.mjs",
    "plan:check": "node scripts/plan-register-check.mjs",
    "repo:move": "node scripts/repo-move.mjs",
    "skills:check": "node scripts/skills-check.mjs",
    "estate:matrix": "node scripts/estate-matrix.mjs",
    "receipts:verify": "node scripts/run-receipt.mjs",
    "receipts:collect": "node scripts/receipts-collect.mjs",
    "digest": "node scripts/founders-digest.mjs",
    "digest:waiting": "node scripts/founders-digest.mjs --waiting",
    "audit:repos:offline": "node scripts/repo-audit.mjs --repos-file audit/repos.inventory.json --open",
    "test": "cd core && node --test"
  },
  "dependencies": {
    "marked": "^18.0.5"
  }
}
